# Copy to .env and `export $(cat .env | xargs)` or set in your shell profile.

# Granola official API key (grn_...) — generate in the Granola desktop app
# (Settings → API keys; a workspace admin may need to enable personal keys).
# REQUIRED on Granola >= 7.427, which encrypts its local data. When set,
# fk sync uses the official API automatically.
#GRANOLA_API_KEY=grn_...

# Override the official API base URL (rarely needed)
#FK_GRANOLA_API_BASE=https://public-api.granola.ai/v1

# Override where the Granola desktop app's local cache lives
#FK_GRANOLA_CACHE=~/Library/Application Support/Granola/cache-v3.json

# Override where Granola's auth file lives (only used by `fk sync --api`)
#FK_GRANOLA_SUPABASE=~/Library/Application Support/Granola/supabase.json

# Where filler-killer stores its own database
#FK_DB_PATH=~/Library/Application Support/filler-killer/fk.db

# Dashboard bind address
#FK_HOST=127.0.0.1
#FK_PORT=8756
